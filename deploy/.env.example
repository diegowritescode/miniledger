# Server-side configuration for deploy/compose.yml. Copy to deploy/.env on the host.
# Never commit the real file. Generate every secret with: openssl rand -hex 32

# Immutable image tag published by the Release workflow (the full commit SHA).
MINILEDGER_IMAGE_TAG=

# Public hostnames routed by the shared Traefik instance.
API_HOST=ledger.deviego.xyz
WEB_HOST=app.ledger.deviego.xyz

# The AccessCore instance that issues and authorizes tokens. ACCESSCORE_URL is its public URL and
# the required `iss` claim; the API and dashboard call it over the shared edge network instead.
# Set ACCESSCORE_INTERNAL_URL only when AccessCore runs on another host.
ACCESSCORE_URL=https://auth.deviego.xyz
# ACCESSCORE_INTERNAL_URL=http://accesscore-api:3000

# Postgres: owner role (runs migrations) and least-privilege runtime role (ADR-011).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Shared demo: the AccessCore login whose accounts deploy/demo-reset.sh seeds, and the switch
# that allows that script to wipe this instance. Never enable the reset on real data.
DEMO_EMAIL=demo@accesscore.dev
DEMO_PASSWORD="correct horse battery staple"
DEMO_RESET_ENABLED=false

LOG_LEVEL=info
