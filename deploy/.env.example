# Server-side configuration for deploy/compose.yml. Copy to deploy/.env on the host.
# Never commit the real file. Generate every secret with: openssl rand -hex 32

# Immutable image tag published by the Release workflow (the full commit SHA).
MINILEDGER_IMAGE_TAG=

# Public hostnames routed by the shared Traefik instance.
API_HOST=ledger.deviego.xyz
WEB_HOST=app.ledger.deviego.xyz

# The AccessCore instance that issues and authorizes tokens.
ACCESSCORE_URL=https://auth.deviego.xyz

# Postgres: owner role (runs migrations) and least-privilege runtime role (ADR-011).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

LOG_LEVEL=info
